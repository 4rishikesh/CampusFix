# Copy to .env and add your own local credentials. Do not commit .env.
PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/campusfix
JWT_SECRET=replace_with_a_long_random_secret
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
