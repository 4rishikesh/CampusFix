# Copy to .env and add your own local credentials. Do not commit .env.
PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/campusfix
JWT_SECRET=replace_with_a_long_random_secret
# Comma-separated browser origins. Required when NODE_ENV=production.
CLIENT_ORIGIN=http://localhost:5173
# Used only by `npm run seed:admin`; register this account first, then promote it.
ADMIN_BOOTSTRAP_EMAIL=campus-admin@example.edu
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
